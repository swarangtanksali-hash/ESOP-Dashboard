import { useState, useMemo } from "react";

const fmt = (val) => {
  const abs = Math.abs(val);
  const sign = val < 0 ? "−" : "";
  if (abs >= 100) return `${sign}₹${(abs / 100).toFixed(2)} Cr`;
  if (abs >= 1) return `${sign}₹${abs.toFixed(2)}L`;
  return `${sign}₹${(abs * 100).toFixed(0)}K`;
};

const fmtShort = (n) => {
  const abs = Math.abs(n);
  const s = n < 0 ? "−" : "+";
  if (abs >= 100) return `${s}₹${(abs / 100).toFixed(1)}Cr`;
  return `${s}₹${abs.toFixed(1)}L`;
};

export default function ESOPDashboard() {
  const [currentVal, setCurrentVal] = useState(64);
  const [existingGrant, setExistingGrant] = useState(30);
  const [vestPct, setVestPct] = useState(45);
  const [accel, setAccel] = useState(false);
  const [exercisePct, setExercisePct] = useState(25);
  const [taxRate, setTaxRate] = useState(30);
  const [exitVal, setExitVal] = useState(150);

  const [grants, setGrants] = useState([]);
  const [newGrant, setNewGrant] = useState({ label: "", grantINR: 0, vestPct: 100 });

  const addGrant = () => {
    if (!newGrant.grantINR) return;
    setGrants(g => [...g, { ...newGrant, id: Date.now(), label: newGrant.label || `Grant ${grants.length + 2}` }]);
    setNewGrant({ label: "", grantINR: 0, vestPct: 100 });
  };

  const removeGrant = (id) => setGrants(g => g.filter(x => x.id !== id));

  const calc = useMemo(() => {
    const mult = exitVal / currentVal;
    const effVest = accel ? 1 : vestPct / 100;

    const exGrantExit = existingGrant * mult;
    const exVested = exGrantExit * effVest;
    const exStrike = existingGrant * (exercisePct / 100) * effVest;
    const exGross = exVested - exStrike;
    const exTax = Math.max(0, exGross) * (taxRate / 100);
    const exNet = Math.max(0, exGross) - exTax;

    const incRows = grants.map(g => {
      const grantExit = g.grantINR * mult;
      const vested = grantExit * (g.vestPct / 100);
      const strike = g.grantINR * (exercisePct / 100) * (g.vestPct / 100);
      const gross = vested - strike;
      const tax = Math.max(0, gross) * (taxRate / 100);
      const net = Math.max(0, gross) - tax;
      return { ...g, grantExit, vested, strike, gross, tax, net };
    });

    const totalNet = exNet + incRows.reduce((a, r) => a + r.net, 0);
    const totalGross = exGross + incRows.reduce((a, r) => a + r.gross, 0);
    const totalStrike = exStrike + incRows.reduce((a, r) => a + r.strike, 0);
    const totalTax = exTax + incRows.reduce((a, r) => a + r.tax, 0);
    const totalExitVal = exVested + incRows.reduce((a, r) => a + r.vested, 0);

    return { exGrantExit, exVested, exStrike, exGross, exTax, exNet, incRows, totalNet, totalGross, totalStrike, totalTax, totalExitVal };
  }, [exitVal, currentVal, existingGrant, vestPct, accel, exercisePct, taxRate, grants]);

  const scenarios = [50, 100, 150, 200, 250, 300, 400];

  const css = {
    app: { fontFamily: "'DM Mono', 'Fira Code', monospace", background: "#080c14", minHeight: "100vh", color: "#c9d1e0", padding: "28px 24px", maxWidth: 900, margin: "0 auto" },
    section: { background: "#0f1520", border: "1px solid #1c2535", borderRadius: 10, padding: "18px 20px", marginBottom: 16 },
    label: { fontSize: 10, color: "#3d5070", textTransform: "uppercase", letterSpacing: "0.1em", fontWeight: 600 },
    h2: { fontSize: 11, color: "#3d5070", textTransform: "uppercase", letterSpacing: "0.1em", fontWeight: 700, marginBottom: 14 },
    input: { background: "#080c14", border: "1px solid #1c2535", borderRadius: 6, color: "#c9d1e0", padding: "7px 10px", fontSize: 13, width: "100%", outline: "none", fontFamily: "inherit" },
    btn: { background: "#1c4ed8", border: "none", borderRadius: 6, color: "#fff", padding: "8px 16px", cursor: "pointer", fontSize: 12, fontFamily: "inherit", fontWeight: 700 },
    tag: (color) => ({ background: color + "18", border: `1px solid ${color}40`, color, borderRadius: 4, padding: "1px 7px", fontSize: 11, fontWeight: 700 }),
  };

  const StatCard = ({ label, value, accent, small }) => (
    <div style={{ background: "#080c14", border: `1px solid ${accent}30`, borderRadius: 8, padding: "14px 16px" }}>
      <div style={{ ...css.label, marginBottom: 6 }}>{label}</div>
      <div style={{ fontSize: small ? 18 : 24, fontWeight: 800, color: accent, letterSpacing: "-0.02em", lineHeight: 1 }}>{value}</div>
    </div>
  );

  const SliderRow = ({ label, value, min, max, step, onChange, display, color = "#4a90d9" }) => (
    <div style={{ marginBottom: 16 }}>
      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 5 }}>
        <span style={css.label}>{label}</span>
        <span style={{ fontSize: 13, fontWeight: 700, color }}>{display ?? value}</span>
      </div>
      <input type="range" min={min} max={max} step={step} value={value} onChange={e => onChange(+e.target.value)}
        style={{ width: "100%", accentColor: color, cursor: "pointer", height: 4 }} />
    </div>
  );

  return (
    <div style={css.app}>
      <div style={{ marginBottom: 22, borderBottom: "1px solid #1c2535", paddingBottom: 16 }}>
        <div style={{ display: "flex", alignItems: "baseline", gap: 12 }}>
          <h1 style={{ fontSize: 18, fontWeight: 800, color: "#e2e8f0", margin: 0, letterSpacing: "-0.02em" }}>ESOP Exit Calculator</h1>
          <span style={css.tag("#64748b")}>Snaptrude</span>
        </div>
        <div style={{ fontSize: 11, color: "#2d3d54", marginTop: 4 }}>Cashless / bonus settlement · Exercise price = {exercisePct}% of FMV</div>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "280px 1fr", gap: 16, alignItems: "start" }}>

        <div>
          <div style={css.section}>
            <div style={css.h2}>Existing ESOP</div>
            <div style={{ marginBottom: 12 }}>
              <div style={{ ...css.label, marginBottom: 5 }}>Grant Value at ${currentVal}M (₹L)</div>
              <input style={css.input} type="number" value={existingGrant} onChange={e => setExistingGrant(+e.target.value)} />
            </div>
            <div style={{ marginBottom: 12 }}>
              <div style={{ ...css.label, marginBottom: 5 }}>Current Valuation ($M)</div>
              <input style={css.input} type="number" value={currentVal} onChange={e => setCurrentVal(+e.target.value)} />
            </div>
            <SliderRow label="Vested %" value={accel ? 100 : vestPct} min={0} max={100} step={5}
              onChange={setVestPct} display={`${accel ? 100 : vestPct}%`} color="#a78bfa" />
            <div style={{ display: "flex", alignItems: "center", gap: 7, marginBottom: 4 }}>
              <input type="checkbox" id="ac" checked={accel} onChange={e => setAccel(e.target.checked)} style={{ accentColor: "#34d399", cursor: "pointer" }} />
              <label htmlFor="ac" style={{ fontSize: 11, color: "#4a5568", cursor: "pointer" }}>Accelerated vesting at exit</label>
            </div>
          </div>

          <div style={css.section}>
            <div style={css.h2}>Add Incremental Grant</div>
            <div style={{ marginBottom: 8 }}>
              <div style={{ ...css.label, marginBottom: 4 }}>Label (optional)</div>
              <input style={css.input} placeholder="e.g. FY26 top-up" value={newGrant.label}
                onChange={e => setNewGrant(g => ({ ...g, label: e.target.value }))} />
            </div>
            <div style={{ marginBottom: 8 }}>
              <div style={{ ...css.label, marginBottom: 4 }}>Grant Value at ${currentVal}M (₹L)</div>
              <input style={css.input} type="number" value={newGrant.grantINR || ""}
                onChange={e => setNewGrant(g => ({ ...g, grantINR: +e.target.value }))} placeholder="0" />
            </div>
            <div style={{ marginBottom: 12 }}>
              <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 4 }}>
                <span style={css.label}>Vesting % at exit</span>
                <span style={{ fontSize: 12, fontWeight: 700, color: "#34d399" }}>{newGrant.vestPct}%</span>
              </div>
              <input type="range" min={0} max={100} step={5} value={newGrant.vestPct}
                onChange={e => setNewGrant(g => ({ ...g, vestPct: +e.target.value }))}
                style={{ width: "100%", accentColor: "#34d399", cursor: "pointer" }} />
            </div>
            <button style={css.btn} onClick={addGrant}>+ Add Grant</button>
          </div>

          <div style={css.section}>
            <div style={css.h2}>Parameters</div>
            <SliderRow label="Exercise Price (% of FMV)" value={exercisePct} min={0} max={100} step={5}
              onChange={setExercisePct} display={`${exercisePct}%`} color="#fbbf24" />
            <SliderRow label="Tax Rate" value={taxRate} min={10} max={40} step={5}
              onChange={setTaxRate} display={`${taxRate}%`} color="#f87171" />
          </div>
        </div>

        <div>
          <div style={{ ...css.section, borderColor: "#1c4ed850", background: "#0a1020" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 10 }}>
              <span style={css.h2}>Exit Valuation</span>
              <span style={{ fontSize: 32, fontWeight: 900, color: "#60a5fa", letterSpacing: "-0.04em" }}>${exitVal}M</span>
            </div>
            <input type="range" min={20} max={500} step={10} value={exitVal} onChange={e => setExitVal(+e.target.value)}
              style={{ width: "100%", accentColor: "#60a5fa", cursor: "pointer" }} />
            <div style={{ display: "flex", justifyContent: "space-between", marginTop: 4, fontSize: 10, color: "#2d3d54" }}>
              {[50, 100, 150, 200, 300, 400, 500].map(v => (
                <span key={v} onClick={() => setExitVal(v)} style={{ cursor: "pointer", color: exitVal === v ? "#60a5fa" : "#2d3d54" }}>${v}M</span>
              ))}
            </div>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 10, marginBottom: 16 }}>
            <StatCard label="Shares Value at Exit" value={fmt(calc.totalExitVal)} accent="#60a5fa" />
            <StatCard label="Exercise Cost" value={`−${fmt(calc.totalStrike)}`} accent="#f87171" />
            <StatCard label="Gross Gain" value={fmt(calc.totalGross)} accent="#a78bfa" />
            <StatCard label="Tax Payable" value={`−${fmt(calc.totalTax)}`} accent="#fbbf24" />
            <StatCard label="Net Cash in Hand" value={fmt(calc.totalNet)} accent="#34d399" />
            <StatCard label="Multiple on Grant" value={`${(calc.totalNet / (existingGrant + grants.reduce((a, g) => a + g.grantINR, 0))).toFixed(2)}×`} accent="#e879f9" />
          </div>

          {grants.length > 0 && (
            <div style={css.section}>
              <div style={css.h2}>Grant Breakdown at ${exitVal}M</div>
              <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 11 }}>
                <thead>
                  <tr style={{ color: "#3d5070" }}>
                    {["Grant", "Vest%", "Value at Exit", "Exercise Cost", "Gross", "Tax", "Net"].map(h => (
                      <th key={h} style={{ textAlign: "right", padding: "5px 8px", fontWeight: 600, borderBottom: "1px solid #1c2535" }}>{h}</th>
                    ))}
                    <th style={{ padding: "5px 8px", borderBottom: "1px solid #1c2535" }}></th>
                  </tr>
                </thead>
                <tbody>
                  <tr style={{ background: "#0f1520" }}>
                    <td style={{ padding: "7px 8px", color: "#a78bfa", fontWeight: 700, textAlign: "right" }}>Existing</td>
                    <td style={{ padding: "7px 8px", textAlign: "right", color: "#64748b" }}>{accel ? 100 : vestPct}%</td>
                    <td style={{ padding: "7px 8px", textAlign: "right", color: "#60a5fa" }}>{fmt(calc.exVested)}</td>
                    <td style={{ padding: "7px 8px", textAlign: "right", color: "#f87171" }}>−{fmt(calc.exStrike)}</td>
                    <td style={{ padding: "7px 8px", textAlign: "right", color: "#a78bfa" }}>{fmt(calc.exGross)}</td>
                    <td style={{ padding: "7px 8px", textAlign: "right", color: "#fbbf24" }}>−{fmt(calc.exTax)}</td>
                    <td style={{ padding: "7px 8px", textAlign: "right", color: "#34d399", fontWeight: 700 }}>{fmt(calc.exNet)}</td>
                    <td></td>
                  </tr>
                  {calc.incRows.map(r => (
                    <tr key={r.id}>
                      <td style={{ padding: "7px 8px", color: "#94a3b8", textAlign: "right" }}>{r.label}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#64748b" }}>{r.vestPct}%</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#60a5fa" }}>{fmt(r.vested)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#f87171" }}>−{fmt(r.strike)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#a78bfa" }}>{fmt(r.gross)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#fbbf24" }}>−{fmt(r.tax)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#34d399", fontWeight: 700 }}>{fmt(r.net)}</td>
                      <td style={{ padding: "7px 8px" }}>
                        <span onClick={() => removeGrant(r.id)} style={{ cursor: "pointer", color: "#3d5070", fontSize: 13 }}>✕</span>
                      </td>
                    </tr>
                  ))}
                  <tr style={{ borderTop: "1px solid #1c2535" }}>
                    <td colSpan={4} style={{ padding: "8px 8px", color: "#3d5070", textAlign: "right", fontSize: 10, textTransform: "uppercase", letterSpacing: "0.07em" }}>Total</td>
                    <td style={{ padding: "8px 8px", textAlign: "right", color: "#a78bfa", fontWeight: 700 }}>{fmt(calc.totalGross)}</td>
                    <td style={{ padding: "8px 8px", textAlign: "right", color: "#fbbf24", fontWeight: 700 }}>−{fmt(calc.totalTax)}</td>
                    <td style={{ padding: "8px 8px", textAlign: "right", color: "#34d399", fontWeight: 900, fontSize: 14 }}>{fmt(calc.totalNet)}</td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </div>
          )}

          <div style={css.section}>
            <div style={css.h2}>Scenario Matrix — Net Cash in Hand</div>
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 11 }}>
              <thead>
                <tr style={{ color: "#3d5070" }}>
                  {["Exit Val", "Shares Value", "Exercise Cost", "Gross Gain", "Tax", "Net Cash"].map(h => (
                    <th key={h} style={{ padding: "5px 8px", textAlign: "right", fontWeight: 600, borderBottom: "1px solid #1c2535" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {scenarios.map(v => {
                  const mult = v / currentVal;
                  const effVest = accel ? 1 : vestPct / 100;
                  const ev = existingGrant * mult * effVest + grants.reduce((a, g) => a + g.grantINR * mult * (g.vestPct / 100), 0);
                  const strike = existingGrant * (exercisePct / 100) * effVest + grants.reduce((a, g) => a + g.grantINR * (exercisePct / 100) * (g.vestPct / 100), 0);
                  const gross = ev - strike;
                  const tax = Math.max(0, gross) * (taxRate / 100);
                  const net = Math.max(0, gross) - tax;
                  const isActive = v === exitVal;
                  return (
                    <tr key={v} onClick={() => setExitVal(v)}
                      style={{ background: isActive ? "#1c2d4a" : "transparent", cursor: "pointer" }}>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: isActive ? "#60a5fa" : v === currentVal ? "#fbbf24" : "#64748b", fontWeight: isActive ? 800 : 500 }}>
                        ${v}M{v === currentVal ? " ·" : ""}
                      </td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#94a3b8" }}>{fmt(ev)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#f87171" }}>−{fmt(strike)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: gross >= 0 ? "#a78bfa" : "#f87171" }}>{fmt(gross)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#fbbf24" }}>−{fmt(tax)}</td>
                      <td style={{ padding: "7px 8px", textAlign: "right", color: "#34d399", fontWeight: 700 }}>{fmt(net)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <div style={{ fontSize: 10, color: "#2d3d54", marginTop: 8 }}>Click any row to update exit slider. · = current valuation.</div>
          </div>
        </div>
      </div>
    </div>
  );
}
